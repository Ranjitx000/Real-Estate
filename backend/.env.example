# ─── Backend Environment — Template ────────────────────────────────────────────
# Copy to backend/.env and fill in all values before starting the server.

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # "development" or "production"

# ── MongoDB ─────────────────────────────────────────────────────────────────────
MONGODBURL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379           # local
# REDIS_URL=rediss://:<password>@<host>:6380   # production TLS

# ── Cloudinary (image uploads) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Twilio (OTP / SMS) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── CORS — allowed frontend origins ─────────────────────────────────────────────
# Dev:   ALLOWED_ORIGINS=http://localhost:5173
# Prod:  ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com
ALLOWED_ORIGINS=http://localhost:5173
